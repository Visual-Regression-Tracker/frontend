{
  "name": "vrt-frontend",
  "version": "1.6.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.29.5",
    "jszip": "^3.10.2",
    "konva": "^9.3.22",
    "material-ui-popup-state": "^5.3.7",
    "notistack": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^4.6.2",
    "react-joyride": "^3.2.0",
    "react-konva": "^19.3.2",
    "react-material-ui-form-validator": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.4",
    "use-image": "^1.1.4"
  },
  "scripts": {
    "start": "chmod +x ./env.sh && sh ./env.sh && cp env-config.js ./public/ && vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write integration_tests src *.js *.ts *.md",
    "build": "vite build",
    "check:size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "knip": "knip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p integration_tests",
    "test:pw:serve": "sh ./env.sh && cp env-config.js ./public/ && vite build && vite preview --port ${PW_PORT:-4173} --strictPort",
    "test:pw:install": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx playwright install --with-deps chromium",
    "test:pw:local": "npm run test:pw:install && playwright test",
    "test:pw:debug": "npm run test:pw:install && PWDEBUG=1 playwright test",
    "test:pw:docker": "chmod +x ./test-docker.sh && ./test-docker.sh",
    "test:pw:docker:update": "chmod +x ./test-docker.sh && ./test-docker.sh --update-snapshots",
    "prepare": "husky || true"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-material-ui-form-validator": "^2.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
