{
  "name": "vrt-frontend",
  "version": "1.6.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.15",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/styles": "^5.18.0",
    "@mui/x-data-grid": "^6.20.4",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "konva": "^9.3.22",
    "material-ui-popup-state": "^5.3.7",
    "notistack": "^3.0.2",
    "qs": "^6.16.1",
    "react": "^18.3.1",
    "react-debounce-input": "^3.3.0",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.4.1",
    "react-joyride": "^2.5.5",
    "react-konva": "^18.2.16",
    "react-material-ui-form-validator": "^3.0.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "use-image": "^1.1.4",
    "uuid": "^14.0.0"
  },
  "scripts": {
    "start": "chmod +x ./env.sh && sh ./env.sh && cp env-config.js ./public/ && vite",
    "test": "jest",
    "format": "prettier --write integration_tests src *.js *.ts *.md",
    "build": "vite build",
    "lint": "eslint --ignore-path .gitignore . --ext .ts,.tsx,.jsx,.js",
    "typescheck": "tsc --noEmit",
    "test:pw:serve": "sh ./env.sh && cp env-config.js ./public/ && vite build && vite preview --port 4173 --strictPort",
    "test:pw:install": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx playwright install --with-deps chromium",
    "test:pw:local": "npm run test:pw:install && playwright test",
    "test:pw:debug": "npm run test:pw:install && PWDEBUG=1 playwright test",
    "test:pw:docker": "chmod +x ./test-docker.sh && ./test-docker.sh",
    "test:pw:docker:update": "chmod +x ./test-docker.sh && ./test-docker.sh --update-snapshots"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^12.8.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-material-ui-form-validator": "^2.1.1",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^8.3.5"
  }
}
